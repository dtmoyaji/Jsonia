{
  ".left-sidebar": {
    "background": "white",
    "borderRight": "1px solid #ddd",
    "overflowY": "auto",
    "display": "flex",
    "flexDirection": "column",
    "height": "100%",
    "maxHeight": "100vh",
    "minHeight": "0"
  },
  ".structure-tree": {
    "padding": "10px"
  },
  ".tree-empty": {
    "padding": "20px",
    "textAlign": "center",
    "color": "#95a5a6",
    "fontSize": "13px"
  },
  ".tree-node": {
    "padding": "6px 8px",
    "cursor": "pointer",
    "borderRadius": "4px",
    "fontSize": "13px",
    "marginBottom": "2px",
    "display": "flex",
    "alignItems": "center",
    "gap": "6px",
    "transition": "background 0.2s"
  },
  ".tree-node:hover": {
    "background": "#ecf0f1"
  },
  ".tree-node.selected": {
    "background": "#3498db",
    "color": "white",
    "fontWeight": "500"
  },
  ".tree-node-icon": {
    "fontSize": "14px",
    "width": "16px",
    "textAlign": "center"
  },
  ".tree-node-tag": {
    "fontFamily": "monospace",
    "fontSize": "12px",
    "color": "#e74c3c",
    "fontWeight": "600"
  },
  ".tree-node.selected .tree-node-tag": {
    "color": "#fff"
  },
  ".tree-node-label": {
    "flex": "1",
    "overflow": "hidden",
    "textOverflow": "ellipsis",
    "whiteSpace": "nowrap"
  },
  ".tree-node-actions": {
    "display": "none",
    "gap": "4px"
  },
  ".tree-node:hover .tree-node-actions": {
    "display": "flex"
  },
  ".tree-node-action": {
    "fontSize": "12px",
    "padding": "2px 4px",
    "border": "none",
    "background": "transparent",
    "cursor": "pointer",
    "borderRadius": "2px",
    "opacity": "0.6"
  },
  ".tree-node-action:hover": {
    "opacity": "1",
    "background": "rgba(0,0,0,0.1)"
  },
  ".tree-children": {
    "paddingLeft": "20px"
  },
  ".components-panel": {
    "background": "white",
    "borderRight": "1px solid #ddd",
    "overflowY": "auto"
  },
  ".component-item": {
    "padding": "10px 15px",
    "cursor": "grab",
    "borderBottom": "1px solid #f0f0f0",
    "display": "flex",
    "alignItems": "center",
    "gap": "10px",
    "transition": "all 0.2s",
    "fontSize": "13px",
    "borderLeft": "3px solid transparent",
    "position": "relative"
  },
  ".component-item:hover": {
    "background": "linear-gradient(90deg, #f8f9fa 0%, #ffffff 100%)",
    "borderLeftColor": "#3498db",
    "transform": "translateX(4px)",
    "boxShadow": "0 2px 8px rgba(0, 0, 0, 0.08)"
  },
  ".component-item:active": {
    "cursor": "grabbing",
    "transform": "scale(0.98)",
    "opacity": "0.7"
  },
  ".component-item.dragging": {
    "opacity": "0.5",
    "cursor": "grabbing"
  },
  ".component-category": {
    "marginBottom": "15px"
  },
  ".component-category-header": {
    "padding": "8px 12px",
    "background": "#f8f9fa",
    "fontWeight": "bold",
    "fontSize": "12px",
    "color": "#495057",
    "borderBottom": "2px solid #dee2e6"
  },
  ".shared-components": {
    "borderTop": "3px solid #3498db",
    "marginTop": "20px",
    "paddingTop": "10px"
  },
  ".shared-component-file": {
    "marginLeft": "10px",
    "marginBottom": "10px"
  },
  ".shared-component-file-header": {
    "padding": "6px 12px",
    "background": "#e3f2fd",
    "fontSize": "11px",
    "color": "#1976d2",
    "fontWeight": "600"
  },
  ".component-item.shared-component": {
    "background": "linear-gradient(90deg, #e3f2fd 0%, #f0f8ff 100%)",
    "borderLeft": "4px solid #3498db"
  },
  ".component-item.shared-component:hover": {
    "background": "linear-gradient(90deg, #bbdefb 0%, #e3f2fd 100%)",
    "borderLeftColor": "#2980b9",
    "boxShadow": "0 3px 12px rgba(52, 152, 219, 0.25)"
  },
  ".component-icon": {
    "fontSize": "18px",
    "minWidth": "24px",
    "textAlign": "center"
  },
  ".component-info": {
    "flex": "1",
    "minWidth": "0"
  },
  ".component-name": {
    "fontWeight": "500",
    "color": "#2c3e50",
    "fontSize": "13px"
  },
  ".component-description": {
    "fontSize": "11px",
    "color": "#7f8c8d",
    "marginTop": "2px"
  },
  ".empty-state": {
    "color": "#7f8c8d",
    "textAlign": "center",
    "padding": "20px"
  }
}
