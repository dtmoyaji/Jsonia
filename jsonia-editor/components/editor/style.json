{
  "body": {
    "margin": "0",
    "padding": "0",
    "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
    "background": "#f0f0f0",
    "height": "100vh",
    "overflow": "hidden"
  },
  ".editor-container": {
    "display": "grid",
    "gridTemplateColumns": "280px 1fr 400px",
    "gridTemplateRows": "60px 50px 1fr 40px",
    "height": "100vh",
    "gap": "1px",
    "background": "#ccc"
  },
  ".editor-container > *": {
    "minHeight": "0"
  },
  ".header": {
    "gridColumn": "1 / -1",
    "background": "linear-gradient(135deg, #2c3e50 0%, #34495e 100%)",
    "color": "white",
    "display": "flex",
    "alignItems": "center",
    "padding": "0 20px",
    "justifyContent": "space-between",
    "boxShadow": "0 2px 10px rgba(0, 0, 0, 0.15)"
  },
  ".header h1": {
    "margin": "0",
    "fontSize": "1.5em",
    "fontWeight": "700",
    "letterSpacing": "0.5px",
    "background": "linear-gradient(135deg, #fff 0%, #ecf0f1 100%)",
    "WebkitBackgroundClip": "text",
    "WebkitTextFillColor": "transparent",
    "backgroundClip": "text"
  },
  ".header-actions": {
    "display": "flex",
    "gap": "10px"
  },
  ".editor-tabs": {
    "gridColumn": "1 / -1",
    "background": "#34495e",
    "display": "flex",
    "gap": "2px",
    "padding": "0"
  },
  ".editor-tab": {
    "background": "#2c3e50",
    "color": "#95a5a6",
    "border": "none",
    "padding": "12px 24px",
    "cursor": "pointer",
    "fontSize": "14px",
    "fontWeight": "500",
    "transition": "all 0.2s",
    "borderBottom": "3px solid transparent"
  },
  ".editor-tab:hover": {
    "background": "#34495e",
    "color": "#ecf0f1"
  },
  ".editor-tab.active": {
    "background": "#ecf0f1",
    "color": "#2c3e50",
    "borderBottom": "3px solid #3498db"
  },
  ".footer": {
    "gridColumn": "1 / -1",
    "background": "#34495e",
    "color": "white",
    "display": "flex",
    "alignItems": "center",
    "padding": "0 20px",
    "fontSize": "12px",
    "justifyContent": "space-between"
  }
}
