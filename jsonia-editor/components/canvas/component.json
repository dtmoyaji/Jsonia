{
  "extends": "component",
  "name": "canvas",
  "template": {
    "tag": "main",
    "attributes": {
      "class": "canvas-area"
    },
    "children": [
      {
        "tag": "div",
        "attributes": {
          "class": "canvas-toolbar"
        },
        "children": [
          {
            "tag": "button",
            "text": "↶ 元に戻す",
            "attributes": {
              "class": "btn",
              "data-action": "undo"
            }
          },
          {
            "tag": "button",
            "text": "↷ やり直し",
            "attributes": {
              "class": "btn",
              "data-action": "redo"
            }
          }
        ]
      },
      {
        "tag": "div",
        "attributes": {
          "class": "canvas-content"
        },
        "children": [
          {
            "tag": "div",
            "attributes": {
              "id": "drop-zone",
              "class": "drop-zone"
            },
            "children": [
              {
                "tag": "div",
                "attributes": {
                  "id": "header-drop",
                  "class": "sub-drop header-drop"
                },
                "children": [
                  {
                    "tag": "div",
                    "attributes": {
                      "class": "drop-label"
                    },
                    "text": "Header"
                  }
                ]
              },
              {
                "tag": "div",
                "attributes": {
                  "id": "main-drop",
                  "class": "sub-drop main-drop"
                },
                "children": [
                  {
                    "tag": "div",
                    "attributes": {
                      "class": "drop-label"
                    },
                    "text": "Main"
                  }
                ]
              },
              {
                "tag": "div",
                "attributes": {
                  "id": "footer-drop",
                  "class": "sub-drop footer-drop"
                },
                "children": [
                  {
                    "tag": "div",
                    "attributes": {
                      "class": "drop-label"
                    },
                    "text": "Footer"
                  }
                ]
              },
              {
                "tag": "div",
                "attributes": {
                  "id": "modal-drop",
                  "class": "sub-drop modal-drop"
                },
                "children": [
                  {
                    "tag": "div",
                    "attributes": {
                      "class": "drop-label"
                    },
                    "text": "Modal (design)"
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "behaviorFile": "behavior.json",
  "styleFile": "style.json"
}
