{
  ".canvas-area": {
    "background": "white",
    "position": "relative",
    "overflow": "auto",
    "display": "flex",
    "flexDirection": "column"
  },
  ".canvas-toolbar": {
    "padding": "10px 15px",
    "background": "#f8f9fa",
    "borderBottom": "1px solid #e9ecef",
    "display": "flex",
    "gap": "10px",
    "alignItems": "center"
  },
  ".canvas-content": {
    "flex": "1",
    "padding": "20px"
  },
  ".drop-zone": {
    "minHeight": "500px",
    "border": "2px dashed #e0e0e0",
    "background": "#ffffff",
    "padding": "20px",
    "transition": "border-color 0.2s ease",
    "position": "relative"
  },
  ".drop-zone .sub-drop": {
    "minHeight": "120px",
    "border": "1px dashed rgba(200,200,200,0.6)",
    "borderRadius": "6px",
    "margin": "8px 0",
    "padding": "10px",
    "background": "#fbfbfb"
  },
  ".drop-zone .sub-drop .drop-label": {
    "fontSize": "12px",
    "color": "#95a5a6",
    "fontStyle": "italic",
    "padding": "6px 8px",
    "borderRadius": "4px"
  },
  ".drop-zone .sub-drop.header-drop": {
    "background": "linear-gradient(90deg, #f7fbff 0%, #ffffff 100%)",
    "minHeight": "80px"
  },
  ".drop-zone .sub-drop.main-drop": {
    "background": "#ffffff",
    "minHeight": "320px"
  },
  ".drop-zone .sub-drop.footer-drop": {
    "background": "linear-gradient(90deg, #fffaf7 0%, #ffffff 100%)",
    "minHeight": "80px"
  },
  ".drop-zone .sub-drop.modal-drop": {
    "position": "absolute",
    "right": "20px",
    "top": "20px",
    "width": "360px",
    "minHeight": "140px",
    "background": "rgba(255,255,255,0.98)",
    "border": "1px dashed rgba(150,150,150,0.6)",
    "boxShadow": "0 8px 24px rgba(0,0,0,0.08)",
    "padding": "12px",
    "borderRadius": "8px",
    "zIndex": "20"
  }
}
