{
  "extends": "component",
  "icon": "🃏",
  "name": "カード",
  "tag": "div",
  "type": "container",
  "category": "custom",
  "description": "画像、タイトル、説明、アクションを含むカードコンポーネント",
  "template": {
    "tag": "div",
    "attributes": {
      "class": "card"
    },
    "children": [
      {
        "tag": "img",
        "attributes": {
          "src": "https://via.placeholder.com/300x150?text=Card+Image",
          "alt": "カード画像",
          "class": "card-image"
        }
      },
      {
        "tag": "div",
        "attributes": {
          "data-slot": "children",
          "class": "card-body"
        },
        "children": [
          {
            "tag": "h3",
            "text": "カードタイトル",
            "attributes": {
              "class": "card-title"
            }
          },
          {
            "tag": "p",
            "text": "カードの説明文です。ここに詳細な内容を記述します。",
            "attributes": {
              "class": "card-text"
            }
          },
          {
            "tag": "button",
            "text": "詳細を見る",
            "attributes": {
              "class": "btn card-btn"
            }
          }
        ]
      }
    ]
  },
  "defaultAttributes": {
    "class": "card"
  }
  ,
  "styleFile": "style.json"
}
