{
  ".accordion": {
    "border": "1px solid #ddd",
    "borderRadius": "4px",
    "overflow": "hidden"
  },
  ".accordion-item": {
    "borderBottom": "1px solid #eee"
  },
  ".accordion-header": {
    "padding": "12px 16px",
    "background": "#f8f9fa",
    "cursor": "pointer",
    "display": "flex",
    "alignItems": "center",
    "justifyContent": "space-between"
  },
  ".accordion-content": {
    "padding": "12px 16px",
    "transition": "max-height 0.3s ease, padding 0.2s ease, opacity 0.2s ease",
    "overflow": "hidden",
    "maxHeight": "800px",
    "opacity": "1"
  },
  ".accordion-content.collapsed": {
    "maxHeight": "0",
    "padding": "0 16px",
    "opacity": "0"
  },
  ".accordion-icon.rotated": {
    "transform": "rotate(180deg)",
    "transition": "transform 0.2s ease"
  },
  ".accordion-header.expanded .accordion-icon": {
    "transform": "rotate(180deg)"
  }
}
