{
  ".accordion": {
    "border": "1px solid #ddd",
    "borderRadius": "4px",
    "overflow": "hidden"
  },
  ".accordion-item": {
    "borderBottom": "1px solid #eee"
  },
  ".accordion-header": {
    "padding": "12px 16px",
    "background": "#f8f9fa",
    "cursor": "pointer",
    "display": "flex",
    "alignItems": "center",
    "justifyContent": "space-between"
  },
  ".accordion-content": {
    "padding": "12px 16px",
    "transition": "max-height 0.3s ease",
    "overflow": "hidden"
  },
  ".accordion-header.expanded .accordion-icon": {
    "transform": "rotate(180deg)"
  }
}
