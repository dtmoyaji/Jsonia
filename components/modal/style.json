{
  "selectors": {
    ".modal-overlay": {
      "position": "fixed",
      "top": "0",
      "left": "0",
      "width": "100%",
      "height": "100%",
      "background": "rgba(0,0,0,0.5)",
      "display": "flex",
      "alignItems": "center",
      "justifyContent": "center",
      "zIndex": "1000"
    },
    ".modal-content": {
      "background": "white",
      "borderRadius": "8px",
      "maxWidth": "500px",
      "width": "90%",
      "boxShadow": "0 4px 20px rgba(0,0,0,0.3)"
    },
    ".modal-header": {
      "padding": "16px 20px",
      "borderBottom": "1px solid #ddd",
      "display": "flex",
      "justifyContent": "space-between",
      "alignItems": "center"
    },
    ".modal-body": {
      "padding": "20px"
    },
    ".modal-footer": {
      "padding": "16px 20px",
      "borderTop": "1px solid #ddd",
      "textAlign": "right"
    }
  }
}
